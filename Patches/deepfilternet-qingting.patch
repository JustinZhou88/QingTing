+/// 清听补丁：ERB 增益的释放平滑。每帧（10ms）增益最多下降 `db_per_frame` dB，上升不限。
+/// 模型的增益逐帧抖动，远场低信噪比人声会在字中间被瞬间压下去，听感一顿一顿；
+/// 限制下降速度能填平这些瞬间凹陷，持续噪声仍会在约 100ms 内被压下去。0 = 关闭。
+#[no_mangle]
+pub unsafe extern "C" fn df_set_gain_release(st: *mut DFState, db_per_frame: f32) {
+    let state = st.as_mut().expect("Invalid pointer");
+    state.m.gain_release = if db_per_frame > 0. { 10f32.powf(-db_per_frame / 20.) } else { 0. };
+}
