index 37f9afd..d7db3bd 100644
--- a/libDF/src/capi.rs
+++ b/libDF/src/capi.rs
@@ -251,3 +251,14 @@ pub unsafe extern "C" fn df_gain_size(st: *const DFState) -> DynArray {
 pub unsafe extern "C" fn df_free(model: *mut DFState) {
     let _ = Box::from_raw(model);
 }
+
+
+/// QingTing patch: release smoothing of the gains. Per 10 ms frame the gain may drop by at most
+/// `db_per_frame` dB; rises are not limited. The model's gains jitter from frame to frame, so distant,
+/// low-SNR speech gets pushed down for an instant in the middle of a word and sounds choppy. Limiting
+/// the drop rate fills these dips, while sustained noise is still suppressed within about 100 ms. 0 = off.
+#[no_mangle]
+pub unsafe extern "C" fn df_set_gain_release(st: *mut DFState, db_per_frame: f32) {
+    let state = st.as_mut().expect("Invalid pointer");
+    state.m.gain_release = if db_per_frame > 0. { 10f32.powf(-db_per_frame / 20.) } else { 0. };
+}
